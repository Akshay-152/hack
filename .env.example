# Copy to .env and fill in real values. Never commit .env.

FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# Development-only admin credentials (hashed before storage).
# Replace in production with a proper provisioning flow.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Ollama local AI (all optional — app works when Ollama is stopped)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=90

# SQLite database file override (default: backend/campus_events.db)
# DB_PATH=/absolute/path/to/campus_events.db

# Origin allowed to call the API from the browser
CORS_ORIGIN=http://localhost:5000
